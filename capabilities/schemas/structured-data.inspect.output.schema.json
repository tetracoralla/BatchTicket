{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openadam:capability:structured-data.inspect:v0.1:output",
  "type": "object",
  "additionalProperties": false,
  "required": ["source", "shape", "sample"],
  "properties": {
    "source": { "$ref": "#/$defs/sourceResult" },
    "shape": { "$ref": "#/$defs/shape" },
    "sample": true
  },
  "$defs": {
    "sourceResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "bytes"],
      "properties": {
        "format": { "enum": ["json", "jsonl", "csv", "tsv", "yaml", "parquet"] },
        "bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "fieldProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "minLength": 1, "maxLength": 100 },
        "nullable": { "type": "boolean" },
        "types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 100 }
        },
        "missing_count": { "type": "integer", "minimum": 0 },
        "null_count": { "type": "integer", "minimum": 0 },
        "field_count": { "type": "integer", "minimum": 0 },
        "fields": {
          "type": "object",
          "maxProperties": 1000,
          "additionalProperties": { "$ref": "#/$defs/fieldProfile" }
        },
        "fields_truncated": { "type": "boolean" },
        "nested_truncated": { "type": "boolean" },
        "items_min": { "type": "integer", "minimum": 0 },
        "items_max": { "type": "integer", "minimum": 0 },
        "items": { "$ref": "#/$defs/fieldProfile" }
      }
    },
    "recordSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "select", "selectable", "rows", "columns", "fields"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "select": { "type": ["string", "null"], "maxLength": 4096 },
        "selectable": { "type": "boolean" },
        "rows": { "type": "integer", "minimum": 0 },
        "columns": { "type": "integer", "minimum": 0 },
        "fields": {
          "type": "object",
          "maxProperties": 1000,
          "additionalProperties": { "$ref": "#/$defs/fieldProfile" }
        },
        "fields_truncated": { "type": "boolean" }
      }
    },
    "shape": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["tree", "table"] },
        "type": { "type": "string", "minLength": 1, "maxLength": 100 },
        "rows": { "type": "integer", "minimum": 0 },
        "columns": { "type": "integer", "minimum": 0 },
        "items": { "type": "integer", "minimum": 0 },
        "field_count": { "type": "integer", "minimum": 0 },
        "fields": {
          "type": "object",
          "maxProperties": 1000,
          "additionalProperties": { "$ref": "#/$defs/fieldProfile" }
        },
        "fields_truncated": { "type": "boolean" },
        "record_sets": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/recordSet" }
        },
        "record_sets_truncated": { "type": "boolean" },
        "sample_truncated": { "type": "boolean" }
      }
    }
  }
}
