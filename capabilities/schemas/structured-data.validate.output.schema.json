{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openadam:capability:structured-data.validate:v0.1:output",
  "type": "object",
  "additionalProperties": false,
  "required": ["valid", "shape", "schema_validation", "assertions", "sample"],
  "properties": {
    "valid": { "type": "boolean" },
    "shape": { "$ref": "#/$defs/shape" },
    "schema_validation": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/schemaValidation" }]
    },
    "assertions": {
      "type": "array",
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/assertionResult" }
    },
    "sample": true
  },
  "$defs": {
    "fieldProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "minLength": 1, "maxLength": 100 },
        "nullable": { "type": "boolean" },
        "types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 100 }
        },
        "missing_count": { "type": "integer", "minimum": 0 },
        "null_count": { "type": "integer", "minimum": 0 },
        "field_count": { "type": "integer", "minimum": 0 },
        "fields": {
          "type": "object",
          "maxProperties": 1000,
          "additionalProperties": { "$ref": "#/$defs/fieldProfile" }
        },
        "fields_truncated": { "type": "boolean" },
        "nested_truncated": { "type": "boolean" },
        "items_min": { "type": "integer", "minimum": 0 },
        "items_max": { "type": "integer", "minimum": 0 },
        "items": { "$ref": "#/$defs/fieldProfile" }
      }
    },
    "recordSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "select", "selectable", "rows", "columns", "fields"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "select": { "type": ["string", "null"], "maxLength": 4096 },
        "selectable": { "type": "boolean" },
        "rows": { "type": "integer", "minimum": 0 },
        "columns": { "type": "integer", "minimum": 0 },
        "fields": {
          "type": "object",
          "maxProperties": 1000,
          "additionalProperties": { "$ref": "#/$defs/fieldProfile" }
        },
        "fields_truncated": { "type": "boolean" }
      }
    },
    "shape": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["tree", "table"] },
        "type": { "type": "string", "minLength": 1, "maxLength": 100 },
        "rows": { "type": "integer", "minimum": 0 },
        "columns": { "type": "integer", "minimum": 0 },
        "items": { "type": "integer", "minimum": 0 },
        "field_count": { "type": "integer", "minimum": 0 },
        "fields": {
          "type": "object",
          "maxProperties": 1000,
          "additionalProperties": { "$ref": "#/$defs/fieldProfile" }
        },
        "fields_truncated": { "type": "boolean" },
        "record_sets": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/recordSet" } },
        "record_sets_truncated": { "type": "boolean" },
        "sample_truncated": { "type": "boolean" }
      }
    },
    "schemaValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "records_checked", "failures", "failures_truncated"],
      "properties": {
        "status": { "enum": ["passed", "failed"] },
        "records_checked": { "type": "integer", "minimum": 0 },
        "failures": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["row", "path", "keyword", "message"],
            "properties": {
              "row": { "type": ["integer", "null"], "minimum": 0 },
              "path": { "type": "array", "items": { "type": ["string", "integer"] } },
              "keyword": { "type": ["string", "null"] },
              "message": { "type": "string", "maxLength": 1000 }
            }
          }
        },
        "failures_truncated": { "type": "boolean" }
      }
    },
    "assertionResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "status", "details"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "type": { "enum": ["field_exists", "not_null", "unique", "row_count", "type"] },
        "status": { "enum": ["passed", "failed"] },
        "details": { "type": "object" }
      }
    }
  }
}
